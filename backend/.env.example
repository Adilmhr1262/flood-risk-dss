# Copy to .env and fill in real values
DATABASE_URL=postgresql+psycopg2://flood_user:changeme@localhost:5432/flood_dss
TEST_DATABASE_URL=postgresql+psycopg2://flood_user:changeme@localhost:5432/flood_dss_test
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development

# CORS: comma-separated list of allowed frontend origins.
# Use "*" only for local development. Production deployments MUST set the
# real domain (the app refuses to boot in production with "*").
CORS_ORIGINS=*

# Rate limiting (requests per minute per client IP, sliding window).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# Optional application log file (in addition to stdout).
LOG_FILE=

# Phase 6 — automated early warning. Keep EW_SCHEDULER_ENABLED=false in
# development/tests; enable on the production deployment (single instance).
EW_SCHEDULER_ENABLED=false
EW_CYCLE_MINUTES=30
EW_ALERT_COOLDOWN_HOURS=6
EW_DEFAULT_MODEL=mlp-v1
EW_FORECAST_DAYS=2
# Path to a Firebase service-account JSON for FCM push notifications.
# When unset, notifications run in degraded (log-only) mode.
FCM_SERVICE_ACCOUNT_PATH=
